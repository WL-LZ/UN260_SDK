#!/bin/sh
# Generated exact-path/hash allowlist. No user data, partitions or libraries.
# UN260_STORAGE_SYNC_1: checked filesystem flush and direct backup readback.
set -eu
ROOT=/
USB=/mnt/usb
MOUNTS=/proc/mounts
LOCK=/tmp/un260-resource-cleanup.lock
UPDATER_LOCK=/tmp/un260-updater.lock
BACKUP=$USB/UN260_RESOURCE_BACKUP_20260924
MODE=${1:---check}
UPDATER_PID=${3:-}
REQUIRED_APP_SHA256=@APP_SHA256@
SYNC_TOOL=$ROOT/usr/local/bin/un260_storage_sync
case "$MODE" in --check|--apply|--restore) ;; *) echo 'Usage: sh UN260_RESOURCE_CLEANUP.sh [--check|--apply|--restore]' >&2; exit 2;; esac
[ "$#" -le 1 ] || { [ "$#" = 3 ] && [ "$MODE" = --apply ] && [ "$2" = --updater ]; } || exit 2
fail() { echo "ERROR: $*" >&2; exit 1; }
digest() { sha256sum "$1" | awk '{print $1}'; }
sync() {
    check_usb
    "$SYNC_TOOL" --fd 8 "$USB" || fail 'USB writeback failed; stop cleanup'
    "$SYNC_TOOL" --fd 7 "$ROOT" || fail 'Root writeback failed; stop cleanup'
}
backup_digest() { "$SYNC_TOOL" --hash-direct "$1"; }
manifest() {
    cat <<'UN260_REVIEWED_FILES'
@MANIFEST@
UN260_REVIEWED_FILES
}
safe_path() {
    # Reject symlinks at EVERY component, including the USB mount and backup.
    safe=$1
    [ -n "$safe" ] || return 1
    # Linux treats repeated leading slashes as /. BusyBox dirname preserves
    # exactly //, so ROOT=/ plus /relative must not trap this walk at //.
    while [ "${safe#//}" != "$safe" ]; do safe=${safe#/}; done
    while [ "$safe" != / ] && [ "$safe" != . ]; do
        [ ! -L "$safe" ] || return 1
        parent=$(dirname "$safe") || return 1
        [ "$parent" != "$safe" ] && [ -n "$parent" ] || return 1
        safe=$parent
    done
}
check_usb() {
    safe_path "$USB" || fail 'USB path is a symlink'
    awk -v p="$USB" '$2==p && $1 ~ /^\/dev\// {found=1} END {exit !found}' "$MOUNTS" || fail 'USB is not mounted; refusing rootfs backup'
    [ -d "$USB" ] || fail 'USB missing'
}
if [ "$MODE" != --check ]; then
    [ "$(id -u)" = 0 ] || fail 'Run as root'
    [ ! -e "$ROOT/var/lib/un260-updater/transaction" ] || fail 'Finish/recover the pending UI update first'
    if [ -n "$UPDATER_PID" ]; then
        case "$UPDATER_PID" in *[!0-9]*) fail 'Invalid updater owner';; esac
        safe_path "$UPDATER_LOCK/pid" && [ -f "$UPDATER_LOCK/pid" ] || fail 'Updater lock missing'
        [ "$(cat "$UPDATER_LOCK/pid")" = "$UPDATER_PID" ] &&
            [ "$(awk '/^PPid:/ {print $2}' /proc/$$/status)" = "$UPDATER_PID" ] || fail 'Not the lock-owning updater child'
    else
        # Standalone cleanup and the updater share this lock; no check/use race.
        mkdir "$UPDATER_LOCK" || fail 'Updater is running (or has a stale lock)'
        printf '%s\n' "$$" > "$UPDATER_LOCK/pid"
        trap 'rm -f "$UPDATER_LOCK/pid"; rmdir "$UPDATER_LOCK" 2>/dev/null || :' 0
    fi
    check_usb
    [ -x "$SYNC_TOOL" ] && [ "$("$SYNC_TOOL" --probe)" = UN260_STORAGE_SYNC_1 ] || fail 'Install guarded storage bootstrap before cleanup'
    exec 7< "$ROOT" 8< "$USB"
    sync
    safe_path "$BACKUP" || fail 'Unsafe backup path'
    mkdir "$LOCK" || fail 'Cleanup is already running (or stale lock; inspect before retrying)'
    trap 'rmdir "$LOCK" 2>/dev/null || :; if [ -z "$UPDATER_PID" ]; then rm -f "$UPDATER_LOCK/pid"; rmdir "$UPDATER_LOCK" 2>/dev/null || :; fi' 0
    trap 'exit 1' 1 2 15
fi

if [ "$MODE" = --restore ]; then
    [ -d "$BACKUP/files" ] || fail 'No resource backup found'
    # Validate the complete available backup before any restore writes.
    manifest | while IFS='|' read -r hash bytes mode rel; do
        saved=$BACKUP/files/$rel
        safe_path "$saved" && safe_path "$ROOT/$rel" || fail "Unsafe restore path: $rel"
        [ -e "$saved" ] || continue
        [ -f "$saved" ] && [ "$(backup_digest "$saved")" = "$hash" ] || fail "Backup mismatch: $rel"
        if [ -e "$ROOT/$rel" ]; then
            [ -f "$ROOT/$rel" ] && [ "$(digest "$ROOT/$rel")" = "$hash" ] || fail "Refuse overwriting changed file: $rel"
        fi
    done
    manifest | while IFS='|' read -r hash bytes mode rel; do
        saved=$BACKUP/files/$rel
        [ -f "$saved" ] || continue
        [ ! -e "$ROOT/$rel" ] || continue
        check_usb
        safe_path "$saved" && safe_path "$ROOT/$rel" && safe_path "$ROOT/$rel.un260-resource-restore" || fail "Unsafe restore path: $rel"
        [ ! -e "$ROOT/$rel.un260-resource-restore" ] || fail "Stale restore file: $rel"
        mkdir -p "$(dirname "$ROOT/$rel")"
        cp "$saved" "$ROOT/$rel.un260-resource-restore"
        [ "$(digest "$ROOT/$rel.un260-resource-restore")" = "$hash" ] || fail "Restore verification failed: $rel"
        chmod "$mode" "$ROOT/$rel.un260-resource-restore"
        mv "$ROOT/$rel.un260-resource-restore" "$ROOT/$rel"
        echo "RESTORED $rel"
    done
    sync
    echo 'RESTORE COMPLETE; backup retained.'
    df -k "$ROOT"
    exit 0
fi

icon_cleanup=0
if [ "$REQUIRED_APP_SHA256" != - ] && safe_path "$ROOT/usr/local/bin/test_lvgl" && [ -f "$ROOT/usr/local/bin/test_lvgl" ]; then
    if [ "$(digest "$ROOT/usr/local/bin/test_lvgl")" = "$REQUIRED_APP_SHA256" ]; then icon_cleanup=1; fi
fi
if [ "$REQUIRED_APP_SHA256" = - ]; then
    echo 'Automatic maintenance: SDK demo files only; UI assets and business data excluded.'
elif [ "$icon_cleanup" = 0 ]; then
    echo 'Old/unknown application: SDK demos only. Retired UI icons remain until the matching new application is installed.'
fi

if [ "$MODE" = --apply ]; then
    # Manifest is fixed in this reviewed script, never read from an editable USB list.
    safe_path "$BACKUP/files" && safe_path "$BACKUP/plan.pending" || fail 'Unsafe backup metadata path'
    [ ! -e "$BACKUP/plan.pending" ] || [ -f "$BACKUP/plan.pending" ] || fail 'Invalid backup metadata'
    mkdir -p "$BACKUP/files"
    required=$(manifest | awk -F'|' '{n+=int(($2+1023)/1024)+4} END {print n+2048}')
    available=$(df -Pk "$USB" | awk 'NR==2 {print $4}')
    case "$available" in ''|*[!0-9]*) fail 'Cannot read USB free space';; esac
    [ "$available" -ge "$required" ] || fail 'Insufficient USB backup space'
    : > "$BACKUP/plan.pending"
fi
manifest | while IFS='|' read -r hash bytes mode rel; do
    case "$rel" in usr/local/share/lvgl_data/*) [ "$icon_cleanup" = 1 ] || continue;; esac
    file=$ROOT/$rel
    if ! safe_path "$file"; then echo "KEEP unsafe path: $rel"; continue; fi
    [ -e "$file" ] || continue
    if [ ! -f "$file" ] || [ "$(digest "$file")" != "$hash" ]; then
        echo "KEEP unknown/modified: $rel"; continue
    fi
    echo "MATCH $bytes bytes $rel"
    [ "$MODE" = --apply ] || continue
    check_usb
    saved=$BACKUP/files/$rel
    safe_path "$saved" && safe_path "$saved.part" || fail "Unsafe backup file: $rel"
    mkdir -p "$(dirname "$saved")"
    if [ -e "$saved" ]; then
        [ -f "$saved" ] && [ "$(digest "$saved")" = "$hash" ] || fail "Existing backup differs: $rel"
    else
        [ ! -e "$saved.part" ] || fail "Incomplete backup; inspect $saved.part before retrying"
        cp "$file" "$saved.part"
        [ "$(digest "$saved.part")" = "$hash" ] || fail "Backup verification failed: $rel"
        mv "$saved.part" "$saved"
    fi
    printf '%s|%s|%s|%s\n' "$hash" "$bytes" "$mode" "$rel" >> "$BACKUP/plan.pending"
done
if [ "$MODE" = --check ]; then
    echo 'CHECK ONLY: nothing removed. --apply backs up all matches before removal.'
    df -k "$ROOT"
    exit 0
fi
sync
check_usb
# Every eligible file has a durable verified USB backup before the first delete.
while IFS='|' read -r hash bytes mode rel; do
    manifest | grep -F -x "$hash|$bytes|$mode|$rel" >/dev/null || fail 'Unexpected backup plan'
    safe_path "$BACKUP/files/$rel" && [ "$(backup_digest "$BACKUP/files/$rel")" = "$hash" ] || fail "Direct backup readback failed: $rel"
done < "$BACKUP/plan.pending"
sync
if [ "$icon_cleanup" = 1 ]; then
    safe_path "$ROOT/usr/local/bin/test_lvgl" && [ -f "$ROOT/usr/local/bin/test_lvgl" ] &&
        [ "$(digest "$ROOT/usr/local/bin/test_lvgl")" = "$REQUIRED_APP_SHA256" ] || fail 'Application changed; keep UI icons'
fi
while IFS='|' read -r hash bytes mode rel; do
    manifest | grep -F -x "$hash|$bytes|$mode|$rel" >/dev/null || fail 'Backup plan differs from the built-in allowlist'
    case "$rel" in usr/local/share/lvgl_data/*)
        [ "$icon_cleanup" = 1 ] || fail 'Keep UI icons for the old/unknown application';;
    esac
    check_usb
    file=$ROOT/$rel
    saved=$BACKUP/files/$rel
    safe_path "$file" && safe_path "$saved" || fail "Path changed: $rel"
    [ -f "$saved" ] && [ "$(digest "$saved")" = "$hash" ] || fail "Backup no longer valid: $rel"
    [ -f "$file" ] && [ "$(digest "$file")" = "$hash" ] || fail "Source changed during cleanup: $rel"
    rm "$file"
    echo "REMOVED $rel"
done < "$BACKUP/plan.pending"
sync
echo "CLEANUP COMPLETE. Recoverable backup: $BACKUP/files"
df -k "$ROOT"
