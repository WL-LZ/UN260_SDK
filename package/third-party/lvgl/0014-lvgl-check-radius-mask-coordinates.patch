From: Codex <codex@openai.com>
Subject: [PATCH] lvgl: keep radius mask coordinates signed before table lookup

diff --git a/src/draw/lv_draw_mask.c b/src/draw/lv_draw_mask.c
--- a/src/draw/lv_draw_mask.c
+++ b/src/draw/lv_draw_mask.c
@@ -473,8 +473,9 @@
  */
 void lv_draw_mask_radius_init(lv_draw_mask_radius_param_t * param, const lv_area_t * rect, lv_coord_t radius, bool inv)
 {
-    lv_coord_t w = lv_area_get_width(rect);
-    lv_coord_t h = lv_area_get_height(rect);
+    /* Keep differences signed and wide until the radius is clamped. */
+    int32_t w = (int32_t)rect->x2 - rect->x1 + 1;
+    int32_t h = (int32_t)rect->y2 - rect->y1 + 1;
     int32_t short_side = LV_MIN(w, h);
     if(radius > short_side >> 1) radius = short_side >> 1;
     if(radius < 0) radius = 0;
@@ -1101,30 +1102,24 @@
         }
         return LV_DRAW_MASK_RES_CHANGED;
     }
-    //    printf("exec: x:%d.. %d, y:%d: r:%d, %s\n", abs_x, abs_x + len - 1, abs_y, p->cfg.radius, p->cfg.outer ? "inv" : "norm");
-
-
-    //    if( abs_x == 276 && abs_x + len - 1 == 479 && abs_y == 63 && p->cfg.radius == 5 && p->cfg.outer == 1) {
-    //        char x = 0;
-    //    }
-    //exec: x:276.. 479, y:63: r:5, inv)
-
-    int32_t k = rect.x1 - abs_x; /*First relevant coordinate on the of the mask*/
-    int32_t w = lv_area_get_width(&rect);
-    int32_t h = lv_area_get_height(&rect);
-    abs_x -= rect.x1;
-    abs_y -= rect.y1;
+    /* D211 GCC 10.2 can compare the zero-extended operands of a narrowed
+     * coordinate difference. Keep the relative row wide and signed so a
+     * rectangle crossing y=0 cannot select a negative circle-table row. */
+    int32_t k = (int32_t)rect.x1 - abs_x;
+    int32_t w = (int32_t)rect.x2 - rect.x1 + 1;
+    int32_t h = (int32_t)rect.y2 - rect.y1 + 1;
+    int32_t rel_y = (int32_t)abs_y - rect.y1;
+    int32_t cir_y = rel_y < radius ? radius - rel_y - 1 : rel_y - (h - radius);
 
     lv_coord_t aa_len;
     lv_coord_t x_start;
-    lv_coord_t cir_y;
-    if(abs_y < radius) {
-        cir_y = radius - abs_y - 1;
-    }
-    else {
-        cir_y = abs_y - (h - radius);
-    }
-    lv_opa_t * aa_opa = get_next_line(p->circle, cir_y, &aa_len, &x_start);
+    if(p->circle == NULL || p->circle->radius != radius || cir_y < 0 || cir_y >= radius) {
+        return outer ? LV_DRAW_MASK_RES_FULL_COVER : LV_DRAW_MASK_RES_TRANSP;
+    }
+    lv_opa_t * aa_opa = get_next_line(p->circle, (lv_coord_t)cir_y, &aa_len, &x_start);
+    if(aa_opa == NULL) {
+        return outer ? LV_DRAW_MASK_RES_FULL_COVER : LV_DRAW_MASK_RES_TRANSP;
+    }
     lv_coord_t cir_x_right = k + w - radius + x_start;
     lv_coord_t cir_x_left = k + radius - x_start - 1;
     lv_coord_t i;
@@ -1512,9 +1507,14 @@
 static lv_opa_t * get_next_line(_lv_draw_mask_radius_circle_dsc_t * c, lv_coord_t y, lv_coord_t * len,
                                 lv_coord_t * x_start)
 {
-    *len = c->opa_start_on_y[y + 1] - c->opa_start_on_y[y];
-    *x_start = c->x_start_on_y[y];
-    return &c->cir_opa[c->opa_start_on_y[y]];
+    uint32_t start = c->opa_start_on_y[y];
+    uint32_t end = c->opa_start_on_y[y + 1];
+    uint32_t x = c->x_start_on_y[y];
+    /* Reject inconsistent table metadata before indexing the opacity buffer. */
+    if(end < start || end > (uint32_t)c->radius * 2U + 2U || x > (uint32_t)c->radius) return NULL;
+    *len = (lv_coord_t)(end - start);
+    *x_start = (lv_coord_t)x;
+    return &c->cir_opa[start];
 }
 
 
diff --git a/src/draw/sw/lv_draw_sw_arc.c b/src/draw/sw/lv_draw_sw_arc.c
--- a/src/draw/sw/lv_draw_sw_arc.c
+++ b/src/draw/sw/lv_draw_sw_arc.c
@@ -98,7 +98,7 @@
     int16_t mask_in_id = LV_MASK_ID_INV;
     lv_draw_mask_radius_param_t mask_in_param;
     bool mask_in_param_valid = false;
-    if(lv_area_get_width(&area_in) > 0 && lv_area_get_height(&area_in) > 0) {
+    if(area_in.x1 <= area_in.x2 && area_in.y1 <= area_in.y2) {
         lv_draw_mask_radius_init(&mask_in_param, &area_in, LV_RADIUS_CIRCLE, true);
         mask_in_param_valid = true;
         mask_in_id = lv_draw_mask_add(&mask_in_param, NULL);
