From: Codex <codex@openai.com>
Date: Thu, 27 Aug 2026 09:00:00 +0800
Subject: [PATCH] lvgl: deduplicate unchanged labels and expose invalidation observer

Avoid re-invalidating dynamic labels and reapplying unchanged object flags.
Add an optional observer for debug-only invalid area attribution; the normal
path pays only one NULL callback check.

---
 src/core/lv_obj.c       | 11 +++++++++++
 src/core/lv_obj_pos.c   |  7 +++++++
 src/core/lv_obj_pos.h   | 10 ++++++++++
 src/widgets/lv_label.c  | 31 ++++++++++++++++++++++---------
 4 files changed, 50 insertions(+), 9 deletions(-)

diff --git a/src/core/lv_obj.c b/src/core/lv_obj.c
--- a/src/core/lv_obj.c
+++ b/src/core/lv_obj.c
@@ -219,5 +219,12 @@ void lv_obj_add_flag(lv_obj_t * obj, lv_obj_flag_t f)
 {
     LV_ASSERT_OBJ(obj, MY_CLASS);
+
+    /* Flag setters are state setters. Re-applying an already active flag must
+     * not invalidate the object or dirty its layout again. This is especially
+     * important for virtualized rows which defensively repeat HIDDEN updates
+     * while scrolling. Keep only the bits that actually change. */
+    f &= ~obj->flags;
+    if(f == 0) return;

     bool was_on_layout = lv_obj_is_layout_positioned(obj);

@@ -246,5 +253,9 @@ void lv_obj_clear_flag(lv_obj_t * obj, lv_obj_flag_t f)
 {
     LV_ASSERT_OBJ(obj, MY_CLASS);
+
+    /* See lv_obj_add_flag(): clearing an inactive flag is a strict no-op. */
+    f &= obj->flags;
+    if(f == 0) return;

     bool was_on_layout = lv_obj_is_layout_positioned(obj);
     if(f & LV_OBJ_FLAG_SCROLLABLE) {

diff --git a/src/core/lv_obj_pos.h b/src/core/lv_obj_pos.h
--- a/src/core/lv_obj_pos.h
+++ b/src/core/lv_obj_pos.h
@@ -25,6 +25,8 @@
 struct _lv_obj_t;

 typedef void (*lv_layout_update_cb_t)(struct _lv_obj_t *, void * user_data);
+typedef void (*lv_obj_invalidation_monitor_cb_t)(const struct _lv_obj_t * obj,
+                                                 const lv_area_t * area);
 typedef struct {
     lv_layout_update_cb_t cb;
     void * user_data;
@@ -381,6 +383,14 @@
 void lv_obj_invalidate(const struct _lv_obj_t * obj);

 /**
+ * Register an optional invalidation observer.  It is intended for profiling:
+ * the callback runs only for visible, clipped invalid areas immediately before
+ * they are submitted to the display invalid-area accumulator.
+ * @param cb callback or NULL to disable monitoring
+ */
+void lv_obj_set_invalidation_monitor_cb(lv_obj_invalidation_monitor_cb_t cb);
+
+/**
  * Tell whether an area of an object is visible (even partially) now or not
  * @param obj       pointer to an object
  * @param area      the are to check. The visible part of the area will be written back here.
diff --git a/src/core/lv_obj_pos.c b/src/core/lv_obj_pos.c
--- a/src/core/lv_obj_pos.c
+++ b/src/core/lv_obj_pos.c
@@ -32,6 +32,7 @@
  *  STATIC VARIABLES
  **********************/
 static uint32_t layout_cnt;
+static lv_obj_invalidation_monitor_cb_t invalidation_monitor_cb;

 /**********************
  *      MACROS
@@ -845,6 +846,7 @@ void lv_obj_invalidate_area(const lv_obj_t * obj, const lv_area_t * area)
     lv_area_copy(&area_tmp, area);
     if(!lv_obj_area_is_visible(obj, &area_tmp)) return;

+    if(invalidation_monitor_cb != NULL) invalidation_monitor_cb(obj, &area_tmp);
     _lv_inv_area(lv_obj_get_disp(obj),  &area_tmp);
 }

@@ -865,6 +867,11 @@ void lv_obj_invalidate(const lv_obj_t * obj)

 }

+void lv_obj_set_invalidation_monitor_cb(lv_obj_invalidation_monitor_cb_t cb)
+{
+    invalidation_monitor_cb = cb;
+}
+
 bool lv_obj_area_is_visible(const lv_obj_t * obj, lv_area_t * area)
 {
     if(lv_obj_has_flag(obj, LV_OBJ_FLAG_HIDDEN)) return false;
diff --git a/src/widgets/lv_label.c b/src/widgets/lv_label.c
--- a/src/widgets/lv_label.c
+++ b/src/widgets/lv_label.c
@@ -87,6 +87,15 @@ void lv_label_set_text(lv_obj_t * obj, const char * text)
     LV_ASSERT_OBJ(obj, MY_CLASS);
     lv_label_t * label = (lv_label_t *)obj;

+    /* Dynamic labels own a private copy, therefore equal content means that
+     * neither geometry nor drawing can change.  Keep text == label->text and
+     * text == NULL semantics intact because callers can use them to force a
+     * refresh after modifying the existing buffer. */
+    if(text != NULL && text != label->text && label->text != NULL &&
+       label->static_txt == 0 && strcmp(label->text, text) == 0) {
+        return;
+    }
+
     lv_obj_invalidate(obj);

     /*If text is NULL then just refresh with the current text*/
@@ -146,27 +155,37 @@ void lv_label_set_text(lv_obj_t * obj, const char * text)

 void lv_label_set_text_fmt(lv_obj_t * obj, const char * fmt, ...)
 {
+    char * new_text;
+
     LV_ASSERT_OBJ(obj, MY_CLASS);
     LV_ASSERT_NULL(fmt);

-    lv_obj_invalidate(obj);
     lv_label_t * label = (lv_label_t *)obj;

     /*If text is NULL then refresh*/
     if(fmt == NULL) {
+        lv_obj_invalidate(obj);
         lv_label_refr_text(obj);
         return;
     }

-    if(label->text != NULL && label->static_txt == 0) {
-        lv_mem_free(label->text);
-        label->text = NULL;
-    }
-
     va_list args;
     va_start(args, fmt);
-    label->text = _lv_txt_set_text_vfmt(fmt, args);
+    new_text = _lv_txt_set_text_vfmt(fmt, args);
     va_end(args);
+    if(new_text == NULL) return;
+
+    if(label->text != NULL && label->static_txt == 0 &&
+       strcmp(label->text, new_text) == 0) {
+        lv_mem_free(new_text);
+        return;
+    }
+
+    lv_obj_invalidate(obj);
+    if(label->text != NULL && label->static_txt == 0) {
+        lv_mem_free(label->text);
+    }
+    label->text = new_text;
     label->static_txt = 0; /*Now the text is dynamically allocated*/

     lv_label_refr_text(obj);
--
2.34.1
