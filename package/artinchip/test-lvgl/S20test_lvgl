#!/bin/sh
#
# Start test_lvgl....
#


DAEMON="/usr/local/bin/test_lvgl"
DAEMONOPTS="-qws"
PIDFILE=/var/run/test_lvgl.pid
DEFER_PIDFILE=/var/run/test_lvgl.defer.pid
MDEV_PIDFILE=/var/run/mdev.pid
STARTUP_LOG=/tmp/test_lvgl.startup.log
TSCALIB=/etc/pointercal
CPUFREQ_GOVERNOR=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
CPUFREQ_SAVED=/var/run/test_lvgl.cpufreq_governor
UI_CPU_GOVERNOR=performance
REQUIRED_DEVICES="/dev/fb0 /dev/ge /dev/ttyS4 /dev/ttyS5 /dev/ttyS6"
TOUCH_MODULE_NAME=gt9xx_core
TOUCH_MODULE_FILE="/lib/modules/$(uname -r)/kernel/drivers/input/touchscreen/gt9xx/gt9xx_core.ko"
TOUCH_DEVICE=""

cpu_performance_enter() {
      [ -r "$CPUFREQ_GOVERNOR" ] || return 0
      [ -w "$CPUFREQ_GOVERNOR" ] || return 0

      current_governor=$(cat "$CPUFREQ_GOVERNOR" 2>/dev/null)
      if [ -n "$current_governor" ] && [ ! -f "$CPUFREQ_SAVED" ]; then
          printf '%s\n' "$current_governor" > "$CPUFREQ_SAVED"
      fi

      if [ "$current_governor" != "$UI_CPU_GOVERNOR" ]; then
          printf '%s\n' "$UI_CPU_GOVERNOR" > "$CPUFREQ_GOVERNOR" 2>/dev/null || true
      fi
}

cpu_performance_leave() {
      [ -r "$CPUFREQ_SAVED" ] || return 0
      [ -w "$CPUFREQ_GOVERNOR" ] || return 0

      saved_governor=$(cat "$CPUFREQ_SAVED" 2>/dev/null)
      if [ -n "$saved_governor" ]; then
          printf '%s\n' "$saved_governor" > "$CPUFREQ_GOVERNOR" 2>/dev/null || true
      fi
      rm -f "$CPUFREQ_SAVED"
}

wait_required_devices() {
      wait_count=0
      while [ "$wait_count" -lt 10 ]; do
          missing_devices=""
          for device in $REQUIRED_DEVICES; do
              [ -e "$device" ] || missing_devices="$missing_devices $device"
          done
          if ! find_touch_device; then
              missing_devices="$missing_devices touchscreen"
          fi
          if [ -z "$missing_devices" ]; then
              return 0
          fi
          echo "Waiting for UI devices:$missing_devices"
          sleep 1
          wait_count=$((wait_count + 1))
      done

      echo "UI device readiness timeout; missing:$missing_devices"
      return 1
}

load_touch_driver() {
      if grep -q "^${TOUCH_MODULE_NAME} " /proc/modules 2>/dev/null; then
          return 0
      fi

      if modprobe "$TOUCH_MODULE_NAME" 2>/dev/null; then
          return 0
      fi

      if [ -f "$TOUCH_MODULE_FILE" ] && insmod "$TOUCH_MODULE_FILE" 2>/dev/null; then
          return 0
      fi

      echo "touch module unavailable: $TOUCH_MODULE_NAME ($TOUCH_MODULE_FILE)"
      return 1
}

find_touch_device() {
      for event_path in /sys/class/input/event*; do
          [ -r "$event_path/device/name" ] || continue
          input_name=$(cat "$event_path/device/name" 2>/dev/null)
          case "$input_name" in
              goodix-ts|*goodix*|*Goodix*|*touch*|*Touch*)
                  candidate="/dev/input/${event_path##*/}"
                  if [ -c "$candidate" ]; then
                      TOUCH_DEVICE="$candidate"
                      return 0
                  fi
                  ;;
          esac
      done

      return 1
}

start() {
      if [ "${UN260_MDEV_READY:-0}" != "1" ]; then
          : > "$STARTUP_LOG"
          (
              wait_count=0
              while [ "$wait_count" -lt 10 ]; do
                  mdev_pid=$(cat "$MDEV_PIDFILE" 2>/dev/null)
                  if [ -n "$mdev_pid" ] && kill -0 "$mdev_pid" 2>/dev/null; then
                      rm -f "$DEFER_PIDFILE"
                      UN260_MDEV_READY=1 "$0" start >> "$STARTUP_LOG" 2>&1
                      exit $?
                  fi
                  sleep 1
                  wait_count=$((wait_count + 1))
              done
              echo "Starting test_lvgl: Fail (mdev readiness timeout)" >> "$STARTUP_LOG"
              rm -f "$DEFER_PIDFILE"
              exit 1
          ) &
          defer_pid=$!
          echo "$defer_pid" > "$DEFER_PIDFILE"
          printf "Starting test_lvgl: deferred until mdev is ready\n"
          return 0
      fi

      if [ -f "$PIDFILE" ]; then
          old_pid=$(cat "$PIDFILE" 2>/dev/null)
          if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
              printf "test_lvgl already running (pid %s)\n" "$old_pid"
              return 0
          fi
          rm -f "$PIDFILE"
      fi

      printf "Load touch driver: "
      if load_touch_driver; then
          echo "OK"
      else
          echo "driver load failed; waiting for an existing input device"
      fi
      mdev -s 2>/dev/null || true

      if ! wait_required_devices; then
          printf "Starting test_lvgl: Fail (device readiness timeout, log=%s)\n" "$STARTUP_LOG"
          return 1
      fi

      printf "Starting test_lvgl: "

      export TSLIB_FBDEVICE=/dev/fb0
      export POINTERCAL_CALIBFILE=$TSCALIB
      export TSLIB_CONSOLEDEVICE=none
      export TSLIB_TSDEVICE="$TOUCH_DEVICE"
      export LVGL_EVDEV_DEVICE="$TOUCH_DEVICE"
      export TSLIB_PLUGINDIR=/usr/lib/ts

      echo "Touch input: $TOUCH_DEVICE"

      if [ ! -f "$TSCALIB" ]; then
          /usr/bin/ts_calibrate
      fi
      cpu_performance_enter
      sync
      : > "$STARTUP_LOG"
      "$DAEMON" $DAEMONOPTS >> "$STARTUP_LOG" 2>&1 &
      PID=$!
      if [ -z "$PID" ]; then
          cpu_performance_leave
          printf "Fail \n"
          return 1
      fi

      echo "$PID" > "$PIDFILE"
      sleep 1
      if ! kill -0 "$PID" 2>/dev/null; then
          wait "$PID" 2>/dev/null
          status=$?
          rm -f "$PIDFILE"
          cpu_performance_leave
          printf "Fail (exit=%s, log=%s)\n" "$status" "$STARTUP_LOG"
          return 1
      fi

      printf "OK \n"
      return 0
}

stop() {
	printf "Stopping test_lvgl: "
        if [ -f "$DEFER_PIDFILE" ]; then
            defer_pid=$(cat "$DEFER_PIDFILE" 2>/dev/null)
            if [ -n "$defer_pid" ] && kill -0 "$defer_pid" 2>/dev/null; then
                kill -TERM "$defer_pid" 2>/dev/null || true
            fi
            rm -f "$DEFER_PIDFILE"
        fi
        if [ ! -f "$PIDFILE" ]; then
            cpu_performance_leave
            printf "pidfile not found \n"
            return 0
        fi

        PID=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            kill -TERM "$PID" 2>/dev/null || true
            wait_count=0
            while kill -0 "$PID" 2>/dev/null && [ "$wait_count" -lt 5 ]; do
                sleep 1
                wait_count=$((wait_count + 1))
            done
            if kill -0 "$PID" 2>/dev/null; then
                kill -KILL "$PID" 2>/dev/null || true
            fi
        fi
        rm -f "$PIDFILE"
        cpu_performance_leave
        printf "OK \n"
}

case "$1" in
    start)
	start
	;;
    stop)
	stop
	;;
    restart|reload)
	stop
	start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
