#!/bin/sh
#
# Run the mdev daemon
#

DAEMON="mdev"
PIDFILE="/var/run/$DAEMON.pid"


start() {
	echo -n "Starting $DAEMON... "
	start-stop-daemon -S -b -m -p $PIDFILE -x /sbin/mdev -- -df
	[ $? -eq 0 ] && echo "OK" || echo "ERROR"

	# Preserve synchronous coldplug and every module. Give first-frame work
	# CPU priority without delaying mdev itself or removing device discovery.
	if command -v nice >/dev/null 2>&1; then
		nice -n 10 /bin/sh -c 'find /sys/ -name modalias -print0 |
			xargs -0 sort -u | tr "\n" "\0" | xargs -0 modprobe -abq'
	else
		find /sys/ -name modalias -print0 | \
			xargs -0 sort -u | tr '\n' '\0' | xargs -0 modprobe -abq
	fi
}

stop() {
	echo -n "Stopping $DAEMON... "
	start-stop-daemon -K -p $PIDFILE
	[ $? -eq 0 ] && echo "OK" || echo "ERROR"
}

restart() {
	stop
	start
}

case "$1" in
  start|stop|restart)
	"$1"
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
